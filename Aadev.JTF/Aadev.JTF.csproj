<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net8.0;netstandard2.1</TargetFrameworks>
    <RootNamespace>Aadev.JTF</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Aadev.JTF</AssemblyName>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Authors>aAndrzej-dev</Authors>
    <DebugType>none</DebugType>
    <Copyright>Copyright © aAndrzej-dev 2025</Copyright>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/aAndrzej-dev/Aadev.JTF.git</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<RepositoryBranch>main</RepositoryBranch>
	<RepositoryCommit>8dff0f1</RepositoryCommit>
    <PackageProjectUrl>https://github.com/aAndrzej-dev/Aadev.JTF</PackageProjectUrl>
    <Description>Json Template Format</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>2.0.0-beta7</Version>
    <AssemblyVersion>2.0.0.7</AssemblyVersion>
    <FileVersion>2.0.0.7</FileVersion>
	<Deterministic>true</Deterministic>
	<PackageIcon>JTF.png</PackageIcon>
	<LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
  <PackageReleaseNotes>Changed StringBuilder to JsonBuilder when saving to json
Moved all tools to sub namespace
Added suport for .NET 8
Bug fixes and improvements.
  </PackageReleaseNotes>
  <AnalysisLevel>latest-all</AnalysisLevel>
  <SignAssembly>True</SignAssembly>
  <AssemblyOriginatorKeyFile>C:\Users\aAndrzej\source\keys\aAdnrzej-dev\aAndrzej-dev.snk</AssemblyOriginatorKeyFile>
  <DelaySign>False</DelaySign>
  <Title>Aadev.JTF</Title>
  <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>

  </PropertyGroup>



	
  <ItemGroup>
    <None Include="..\JTF.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="Readme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='netstandard2.1'">
	  <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.0" />
  </ItemGroup>
</Project>
